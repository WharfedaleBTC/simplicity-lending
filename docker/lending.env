# Lending deployment settings: the setup job (docker/setup.sh) writes the web app's config from
# them on every `make run`.

# The principal asset (USDT): issue it in the Wharfedale web app (Assets page) and paste its id.
# Its ticker and decimals are read from the chain. Collateral is WBTC, the chain's fee asset.
PRINCIPAL_ASSET=f58a560b070f3a355a92200fd23a71a5b0b84551e55802c6644ad625a206ba09

# The asset whose holder can collect protocol fees. Default: the principal asset (as upstream:
# any USDT holder can collect them). Must stay the same while offers are open.
PROTOCOL_FEE_KEEPER_ASSET=

# Wharfedale web app (explorer and faucet links).
EXPLORER_URL=http://localhost:8080

# USD prices for LTV and USD figures in the UI (the contracts don't use prices). The browser
# fetches WBTC's live from Coinbase (BTC/USD); WBTC_USD is used only if that fails.

PRINCIPAL_USD=1
