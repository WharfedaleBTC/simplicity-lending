# Lending web app: the static app, /config.json (the deployment's assets), the indexer API and
# a Wharfedale node's Esplora API.
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Written by the setup job (docker/setup.sh) into the mounted /config volume.
  location = /config.json {
    alias /config/config.json;
    add_header Cache-Control "no-store";
  }

  location = /api {
    return 301 /api/;
  }

  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Server-sent events (offer updates).
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  location = /esplora {
    return 301 /esplora/;
  }

  # Read-only Esplora routes, plus POST /tx (broadcast). The node's JSON-RPC (POST /) is not
  # exposed.
  location /esplora/ {
    limit_except GET POST { deny all; }
    if ($request_method = POST) { set $post_ok "no"; }
    if ($uri = /esplora/tx) { set $post_ok "yes"; }
    if ($post_ok = "no") { return 405; }
    proxy_pass ${NODE_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
